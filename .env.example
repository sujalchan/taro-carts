GOOGLE_MAPS_BROWSER_API_KEY=your-google-api-key
# Optional for reverse geocoding; use a separate server-restricted key in production.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional semicolon-separated sample start addresses; use actual dispatch sites for production.
DELIVERY_START_ADDRESSES=8 Queen Street, Auckland CBD, Auckland;16 Putney Way, Manukau, Auckland;216 Puhinui Road, Papatoetoe, Auckland;3058 Great North Road, New Lynn, Auckland
LOGIN_SERVICE_URL=http://localhost:8085
LOGIN_SESSION_LIFETIME=PT8H
LOGIN_COOKIE_SECURE=false

# Optional for the root launchers: blank values get fresh random secrets on each full start.
# Set distinct 32+ character values when running services separately.
LOGIN_CUSTOMER_PROVISIONING_SECRET=
LOGIN_DISPATCHER_PROVISIONING_SECRET=
LOGIN_CUSTOMER_VALIDATION_SECRET=
LOGIN_DISPATCHER_VALIDATION_SECRET=
LOGIN_ALLOCATION_VALIDATION_SECRET=
LOGIN_TARO_VALIDATION_SECRET=
ALLOCATION_CUSTOMER_REFERENCE_SECRET=
ALLOCATION_DISPATCHER_REFERENCE_SECRET=
ALLOCATION_TARO_REFERENCE_SECRET=
ALLOCATION_CUSTOMER_ASSERTION_SECRET=
ALLOCATION_DISPATCHER_ASSERTION_SECRET=
